<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="org.javaboy.vhr.mapper.SalaryChangeLogMapper">
    <resultMap id="BaseResultMap" type="org.javaboy.vhr.model.SalaryChangeLog">
        <id column="id" property="id" jdbcType="INTEGER"/>
        <result column="eid" property="eid" jdbcType="INTEGER"/>
        <result column="old_sid" property="oldSid" jdbcType="INTEGER"/>
        <result column="new_sid" property="newSid" jdbcType="INTEGER"/>
        <result column="operator" property="operator" jdbcType="VARCHAR"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
    </resultMap>
    <sql id="Base_Column_List">
        id, eid, old_sid, new_sid, operator, create_time
    </sql>
    <insert id="insert" parameterType="org.javaboy.vhr.model.SalaryChangeLog" useGeneratedKeys="true"
            keyProperty="id">
        insert into salary_change_log (eid, old_sid, new_sid, operator, create_time)
        values (#{eid,jdbcType=INTEGER}, #{oldSid,jdbcType=INTEGER}, #{newSid,jdbcType=INTEGER},
                #{operator,jdbcType=VARCHAR}, #{createTime,jdbcType=TIMESTAMP})
    </insert>
    <select id="getSalaryChangeLogsByEid" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from salary_change_log
        <where>
            <if test="eid != null">
                and eid = #{eid,jdbcType=INTEGER}
            </if>
        </where>
        order by create_time desc, id desc
    </select>
</mapper>
